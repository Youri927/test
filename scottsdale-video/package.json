{
  "name": "scottsdale-video",
  "version": "1.0.0",
  "private": true,
  "description": "Vidéo 16:9 de présentation du nouveau site de Scottsdale Pool Patio & Landscape Design",
  "scripts": {
    "studio": "remotion studio",
    "capture:site": "node capture/shots.mjs",
    "sound": "node sound/music.mjs && node sound/sfx.mjs",
    "mix": "node sound/mix.mjs out/audio.wav",
    "render": "remotion render Presentation-Scottsdale out/presentation-scottsdale.mp4 --crf=18",
    "finalize": "node sound/finalize.mjs out/presentation-scottsdale.mp4 renders/presentation-scottsdale-16x9.mp4",
    "build": "npm run render && npm run finalize",
    "typecheck": "tsc --noEmit",
    "stills": "node capture/stills.mjs out/stills"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
