# La base de données Postgres (Neon, Supabase, ou un serveur à vous)
DATABASE_URL=postgres://respray@localhost:5433/respray
# Le premier compte de l'équipe, créé par « npm run db:seed »
EQUIPE_EMAIL=equipe@respray.fr
EQUIPE_MOT_DE_PASSE=changez-moi
# Où ranger les photos envoyées par les vendeurs (en local : un dossier)
PHOTOS_DOSSIER=./photos-envoyees
SITE_URL=https://respray.fr
SITE_URL=https://respray.fr
# Stripe : la clé secrète (sk_test_… en test, sk_live_… en production) et le secret du webhook (whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 1 tant que le contrat Mondial Relay n'est pas signé : étiquettes et suivi simulés
ENVOIS_SIMULES=1
# Un long secret aléatoire : le cron appelle /api/taches avec l'en-tête « Authorization: Bearer <secret> »
TACHES_SECRET=
# La clé publiable Stripe (pk_test_… en test, pk_live_… en production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Le secret de la destination d'événements v2 (événements « thin » des comptes vendeurs)
STRIPE_WEBHOOK_SECRET_V2=
# Les e-mails (SMTP). Sans SMTP_HOST, rien ne part (développement). Brevo : smtp-relay.brevo.com, port 587,
# identifiant = l'adresse de connexion SMTP donnée par Brevo, mot de passe = la clé SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_EXPEDITEUR=Respray <noreply@respray.fr>
EMAIL_REPONSE=contact@respray.fr
