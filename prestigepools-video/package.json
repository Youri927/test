{
  "name": "prestigepools-video",
  "version": "1.0.0",
  "private": true,
  "description": "Vidéo 16:9 de présentation du nouveau site de Prestige Pools of Wilmington",
  "scripts": {
    "studio": "remotion studio",
    "capture": "node capture/shots.mjs",
    "music": "node --no-warnings sound/music.mjs",
    "mix": "node --no-warnings sound/mix.mjs out/audio.wav",
    "finalize": "node sound/finalize.mjs out/presentation-ppw.mp4 renders/presentation-ppw-16x9.mp4 out/presentation-ppw-16x9-envoi.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
